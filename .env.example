# Optionales Admin-Passwort beim ersten Start.
# Wird danach gehasht in der DB gespeichert und ignoriert.
# Wenn nicht gesetzt, wird ein zufälliges Passwort generiert und ausgegeben.
ADMIN_PASSWORD=

# Port (Standard: 3000)
PORT=3000

# NODE_ENV=production aktiviert sichere Cookies (nur über HTTPS)
NODE_ENV=development

# Auf 1 setzen wenn hinter einem Reverse Proxy (nginx, Traefik, Caddy)
# Notwendig für korrekte IP-Erkennung im Audit-Log
TRUST_PROXY=0
